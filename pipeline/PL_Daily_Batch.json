{
	"name": "PL_Daily_Batch",
	"properties": {
		"activities": [
			{
				"name": "batchstart",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_BATCH_START",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "Check for files",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "batchstart",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_FILE_POLLING_Coping",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"pBatchDate": {
							"value": "@pipeline().parameters.pbatchdate",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Bronze file to bronze tables load",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Check for files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_BRONZE_LOAD",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"pBatchDate": {
							"value": "@pipeline().parameters.pbatchdate",
							"type": "Expression"
						},
						"pBatchID": {
							"value": "@pipeline().parameters.pbatchID",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Bronze to silver load",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Bronze file to bronze tables load",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Bronze_to_Silver",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"pbatchid": {
							"value": "@pipeline().parameters.pbatchID",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Silver to Gold",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Bronze to silver load",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Gold_Load",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"pBatchid": {
							"value": "@pipeline().parameters.pbatchID",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Archive and Delete Bronze files",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Silver to Gold",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_ARCHIVE",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"pBatchID": {
							"value": "@pipeline().parameters.pbatchID",
							"type": "Expression"
						},
						"pBatchDate": {
							"value": "@pipeline().parameters.pbatchdate",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "Purge old files",
				"type": "ExecutePipeline",
				"dependsOn": [
					{
						"activity": "Archive and Delete Bronze files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_FILE_PURGE",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "Batch End email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Purge old files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": {
						"value": "@pipeline().globalParameters.GP_Logicapp_URL",
						"type": "Expression"
					},
					"body": {
						"value": "{\n\"to\": \"@{pipeline().globalParameters.GP_EMAIL_TO}\",\n\"subject\": \"@{concat(pipeline().globalParameters.GP_CUSTOMER_NAME, ' ', pipeline().globalParameters.GP_ENVIRONMENT, ' Daily Batch Completed ', pipeline().parameters.pbatchdate\n     )   \n     }\",\n\"body\": \"Daily Batch Completed\",\n\"missingFiles\": []\n}\n",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"pbatchdate": {
				"type": "string"
			},
			"pbatchID": {
				"type": "string"
			}
		},
		"folder": {
			"name": "ABC_Dev"
		},
		"annotations": []
	}
}