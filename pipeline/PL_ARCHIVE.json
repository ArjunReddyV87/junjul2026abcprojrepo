{
	"name": "PL_ARCHIVE",
	"properties": {
		"activities": [
			{
				"name": "COPY_BRONZE_TO_ARCHIVE",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "DelimitedTextSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"wildcardFileName": "*",
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "DelimitedTextReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".txt"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"typeConversion": true,
						"typeConversionSettings": {
							"allowDataTruncation": true,
							"treatBooleanAsNumber": false
						}
					}
				},
				"inputs": [
					{
						"referenceName": "DS_Bronze",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DS_ArchivePath",
						"type": "DatasetReference",
						"parameters": {
							"batchid": {
								"value": "@pipeline().parameters.pBatchID",
								"type": "Expression"
							}
						}
					}
				]
			},
			{
				"name": "Delete Bronze files",
				"type": "Delete",
				"dependsOn": [
					{
						"activity": "COPY_BRONZE_TO_ARCHIVE",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Bronze",
						"type": "DatasetReference"
					},
					"logStorageSettings": {
						"linkedServiceName": {
							"referenceName": "LS_abcadlsretaildev",
							"type": "LinkedServiceReference"
						},
						"path": "abcdev/log"
					},
					"enableLogging": true,
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"wildcardFileName": "*",
						"enablePartitionDiscovery": false
					}
				}
			}
		],
		"parameters": {
			"pBatchID": {
				"type": "string"
			},
			"pBatchDate": {
				"type": "string"
			}
		},
		"folder": {
			"name": "ABC_Dev"
		},
		"annotations": []
	}
}