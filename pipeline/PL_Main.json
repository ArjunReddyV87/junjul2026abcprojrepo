{
	"name": "PL_Main",
	"properties": {
		"activities": [
			{
				"name": "set batch date",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vBatchDate",
					"value": {
						"value": "@formatDateTime(\n    convertFromUtc(utcnow(), 'India Standard Time'),\n    'yyyy-MM-dd'\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "set batchid",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "vBatchid",
					"value": {
						"value": "@formatDateTime(utcnow(),'yyyyMMddHHmmss')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Execute daily batch",
				"type": "ExecutePipeline",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [
					{
						"activity": "SP_START_BATCH",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "PL_Daily_Batch",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true,
					"parameters": {
						"pbatchdate": {
							"value": "@variables('vBatchDate')",
							"type": "Expression"
						},
						"pbatchID": {
							"value": "@variables('vBatchid')",
							"type": "Expression"
						}
					}
				}
			},
			{
				"name": "SP_START_BATCH",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "set batch date",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "set batchid",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_StartBatch]",
					"storedProcedureParameters": {
						"BatchDate": {
							"value": {
								"value": "@variables('vBatchDate')",
								"type": "Expression"
							},
							"type": "DateTime"
						},
						"BatchID": {
							"value": {
								"value": "@variables('vBatchid')",
								"type": "Expression"
							},
							"type": "Int64"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_SQLDB",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_BATCH_SUCCESS",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Execute daily batch",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_UpdateBatchStatus]",
					"storedProcedureParameters": {
						"BatchID": {
							"value": {
								"value": "@variables('vBatchid')",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"ErrorMessage": {
							"value": "",
							"type": "String"
						},
						"Status": {
							"value": "SUCCESS",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_SQLDB",
					"type": "LinkedServiceReference"
				}
			},
			{
				"name": "SP_BATCH_FAILURE",
				"type": "SqlServerStoredProcedure",
				"dependsOn": [
					{
						"activity": "Execute daily batch",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"storedProcedureName": "[dbo].[usp_UpdateBatchStatus]",
					"storedProcedureParameters": {
						"BatchID": {
							"value": {
								"value": "@variables('vBatchid')",
								"type": "Expression"
							},
							"type": "Int64"
						},
						"ErrorMessage": {
							"value": {
								"value": "@activity('Execute daily batch').error.message\n",
								"type": "Expression"
							},
							"type": "String"
						},
						"Status": {
							"value": "FAILED",
							"type": "String"
						}
					}
				},
				"linkedServiceName": {
					"referenceName": "LS_SQLDB",
					"type": "LinkedServiceReference"
				}
			}
		],
		"variables": {
			"vBatchDate": {
				"type": "String"
			},
			"vBatchid": {
				"type": "String"
			}
		},
		"annotations": []
	}
}