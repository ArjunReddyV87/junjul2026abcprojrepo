										"value": {
											"value": "@utcNow()",
											"type": "Expression"
										},
										"type": "DateTime"
									},
									"FileExists": {
										"value": {
											"value": "@activity('Get Metadata1').output.exists",
											"type": "Expression"
										},
										"type": "String"
									},
									"FileID": {
										"value": {
											"value": "@item().FileId",
