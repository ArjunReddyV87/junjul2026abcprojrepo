									},
									"FilePath": {
										"value": {
											"value": "@item().SourcePath",
											"type": "Expression"
										},
										"type": "String"
									},
									"RetryNumber": {
										"value": "1",
										"type": "Int32"
									}
								}
							},
							"linkedServiceName": {
								"referenceName": "LS_SQLDB",
								"type": "LinkedServiceReference"
							}
						}
					]
