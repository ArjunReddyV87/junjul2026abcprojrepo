			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "Batch Start email",
						"type": "WebActivity",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"method": "POST",
							"headers": {},
							"url": {
								"value": "@pipeline().globalParameters.GP_Logicapp_URL",
								"type": "Expression"
							},
							"body": {
								"value": "{\n\"to\": \"@{pipeline().globalParameters.GP_EMAIL_TO}\",\n\"subject\": \"@{concat(pipeline().globalParameters.GP_CUSTOMER_NAME, ' ', pipeline().globalParameters.GP_ENVIRONMENT, ' Daily Batch started ', formatDateTime(utcNow(), 'yyyyMMdd'))}\",\n\"body\": \"Daily Batch started\",\n\"missingFiles\": []\n}\n",
								"type": "Expression"
							}
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"folder": {
					"name": "ABC_Dev"
				},
				"annotations": []
			},
			"dependsOn": []
		},
