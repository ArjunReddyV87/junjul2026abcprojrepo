					"type": "LinkedServiceReference"
				},
				"annotations": [],
				"type": "AzureSqlTable",
				"schema": [
					{
						"name": "FileID",
						"type": "int",
						"precision": 10
					},
					{
						"name": "FileName",
						"type": "varchar"
					},
					{
						"name": "FolderName",
						"type": "varchar"
					},
					{
						"name": "SourcePath",
						"type": "varchar"
					},
					{
						"name": "BronzePath",
						"type": "varchar"
					},
					{
						"name": "SilverPath",
						"type": "varchar"
					},
					{
						"name": "RejectedPath",
						"type": "varchar"
