{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "abc-adf-retail-dev"
		},
		"LS_Input_Raw_File_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_Input_Raw_File'"
		},
		"LS_SQLDB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQLDB'"
		},
		"LS_abcadlsretaildev_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_abcadlsretaildev'"
		},
		"LS_DataBricks_accessToken": {
			"type": "secureString",
			"metadata": "Secure string for 'accessToken' of 'LS_DataBricks'"
		},
		"LS_Input_Raw_File_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://abcdevinputstor.dfs.core.windows.net/"
		},
		"LS_SQLDB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "abc-sql-retail-dev.database.windows.net"
		},
		"LS_SQLDB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "ABCRetailDevDB"
		},
		"LS_SQLDB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "abc-sql-retail-dev-adm"
		},
		"LS_abcadlsretaildev_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://abcadlsretaildev.dfs.core.windows.net/"
		},
		"LS_DataBricks_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1009-195026-mlfqubob"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "abc-adf-retail-dev_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_Input_Raw_File_accountKey": {
						"value": "[parameters('LS_Input_Raw_File_accountKey')]"
					},
					"LS_SQLDB_password": {
						"value": "[parameters('LS_SQLDB_password')]"
					},
					"LS_abcadlsretaildev_accountKey": {
						"value": "[parameters('LS_abcadlsretaildev_accountKey')]"
					},
					"LS_DataBricks_accessToken": {
						"value": "[parameters('LS_DataBricks_accessToken')]"
					},
					"LS_Input_Raw_File_properties_typeProperties_url": {
						"value": "[parameters('LS_Input_Raw_File_properties_typeProperties_url')]"
					},
					"LS_SQLDB_properties_typeProperties_server": {
						"value": "[parameters('LS_SQLDB_properties_typeProperties_server')]"
					},
					"LS_SQLDB_properties_typeProperties_database": {
						"value": "[parameters('LS_SQLDB_properties_typeProperties_database')]"
					},
					"LS_SQLDB_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQLDB_properties_typeProperties_userName')]"
					},
					"LS_abcadlsretaildev_properties_typeProperties_url": {
						"value": "[parameters('LS_abcadlsretaildev_properties_typeProperties_url')]"
					},
					"LS_DataBricks_properties_typeProperties_existingClusterId": {
						"value": "[parameters('LS_DataBricks_properties_typeProperties_existingClusterId')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "abc-adf-retail-dev_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'abc-adf-retail-dev_ArmTemplate_0')]"
			]
		}
	]
}